# =============================================================================
# অভ্যাস (Abhyas) — Production Environment Variables
# Copy this file to .env and fill in the values.
# In Coolify, set these as environment variables in the application settings.
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# In Coolify, use the internal Docker network hostname (e.g., abhyas-db:5432)
DATABASE_URL=postgresql://abhyas:secure_password_here@abhyas-db:5432/abhyas?schema=public

# NextAuth configuration
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-secure-secret-here

# The public URL of your deployment
# In Coolify, this should match your domain
NEXTAUTH_URL=https://your-domain.com

# Node environment
NODE_ENV=production

# =============================================================================
# Web Push (VAPID) — for habit reminder push notifications
# =============================================================================
# VAPID (Voluntary Application Server Identification) keys identify your
# server to browser push services (FCM, Apple Push Notification service).
# The PUBLIC key is safe to expose to the browser; the PRIVATE key must
# stay server-side. Generate once and reuse forever:
#
#   bunx web-push generate-vapid-keys
#
# (or programmatically: see `generateVapidKeys()` in src/lib/push-server.ts)
#
# The SUBJECT should be a mailto: or https: URL that identifies the sender
# — push services use it to contact you if there's a problem.
#
# If omitted, /api/push/* routes return 503 and the Profile UI shows
# "এই ব্রাউজারে সমর্থিত নয়" gracefully.
VAPID_PUBLIC_KEY=BKfy7SsubIf1mFc6PAFocPv_BKaQuStCw9Ph7Ws6aPVHy3cAygV1ZlOA26ZRoqbRRKgwUPf4mThUeoGz9hr8V6w
VAPID_PRIVATE_KEY=aCv6ny1mkiTZkoTFQqOBOb7PU-BeoXtA7N6zO0JUrrQ
VAPID_SUBJECT=mailto:hello@abhyas.app

# =============================================================================
# Redis (optional) — for Socket.io horizontal scaling
# =============================================================================
# When set, the social WebSocket service (port 3003) uses a Redis pub/sub
# adapter to share events across multiple instances. Enables horizontal
# scaling for the social/leaderboard feature.
#
# If not set, the social service runs in single-instance mode (sufficient
# for small-to-medium deployments).
# REDIS_URL=redis://redis:6379
