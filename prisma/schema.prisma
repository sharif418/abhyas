// অভ্যাস (Abhyas) — Premium Bengali Habit Tracker
// Production schema for PostgreSQL 16.
// Optimized for multi-million user scale with proper indexes, Json fields, and enums.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

model User {
  id           String   @id @default(cuid())
  name         String   @default("অতিথি")
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?
  avatar       String?
  xp           Int      @default(0)
  level        Int      @default(1)
  city         String   @default("ঢাকা")
  settings     Json     @default("{}") // JSONB: theme, accent, reminders, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  habits        Habit[]
  completions   HabitCompletion[]
  prayers       PrayerRecord[]
  quran         QuranSession[]
  achievements  Achievement[]
  moods         MoodEntry[]
  focusSessions FocusSession[]
  goals         Goal[]
  plannerTasks  PlannerTask[]
  pushSubscriptions PushSubscription[]
  learningTracks LearningTrack[]

  @@index([email])
}

model Habit {
  id             String   @id @default(cuid())
  userId         String
  name           String
  nameEn         String?
  icon           String   @default("CheckCircle")
  category       String   @default("জীবনধারা")
  color          String   @default("#059669")
  target         String   @default("প্রতিদিন")
  frequency      String   @default("প্রতিদিন")
  frequencyDays  Int[]    @default([]) // Native PostgreSQL integer array
  timesPerWeek   Int      @default(0)
  timeOfDay      String   @default("সকাল")
  reminderTime   String?
  note           String? // motivation/goal note shown on the habit detail
  streak         Int      @default(0)
  bestStreak     Int      @default(0)
  totalDone      Int      @default(0)
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  isIslamic      Boolean  @default(false)
  frozenDate     String?
  freezeUsedWeek String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId, active])
  @@index([userId, timeOfDay])
  @@index([userId, streak])
}

model HabitCompletion {
  id          String   @id @default(cuid())
  habitId     String
  userId      String
  date        String // YYYY-MM-DD (Asia/Dhaka)
  completedAt DateTime @default(now())
  note        String?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@index([habitId, date])
}

model PrayerRecord {
  id          String  @id @default(cuid())
  userId      String
  date        String // YYYY-MM-DD
  fajr        Boolean @default(false)
  dhuhr       Boolean @default(false)
  asr         Boolean @default(false)
  maghrib     Boolean @default(false)
  isha        Boolean @default(false)
  sunnahFajr  Boolean @default(false)
  sunnahOther Boolean @default(false)
  tahajjud    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model QuranSession {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD
  surah     Int
  fromAyah  Int
  toAyah    Int
  pagesRead Int      @default(0)
  juz       Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Achievement {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// Cache for Aladhan prayer-time API responses.
model PrayerTimeCache {
  id        String   @id @default(cuid())
  date      String // YYYY-MM-DD
  city      String
  lat       Float
  lng       Float
  method    Int      @default(3)
  times     Json // JSONB: prayer times
  fetchedAt DateTime @default(now())

  @@unique([date, lat, lng, method])
  @@index([date])
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD
  mood      Int // 1..5
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  habitId     String?
  date        String // YYYY-MM-DD
  durationMin Int
  type        String   @default("work")
  tag         String?
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type, date])
}

// লক্ষ্য (Target/Goal) — measurable targets with milestones & deadlines.
// Complements habits (recurring) with FINITE outcomes: "কুরআন খতম ৩০ পারা",
// "১০ কেজি ওজন কমানো", "ইংরেজি ৩০ দিনে শেখা", "৫০,০০০ টাকা জমা"।
model Goal {
  id           String    @id @default(cuid())
  userId       String
  title        String
  category     String    @default("ব্যক্তিগত") // ইবাদত | শেখা ও দক্ষতা | কাজ ও পেশা | স্বাস্থ্য | আর্থিক | ব্যক্তিগত
  icon         String    @default("Target")
  color        String    @default("#059669")
  unit         String    @default("ধাপ") // পাতা | পারা | কেজি | ঘণ্টা | টাকা | দিন | …
  targetValue  Float     @default(100)
  currentValue Float     @default(0)
  deadline     DateTime?
  milestones   Json      @default("[]") // [{ title, value, done }]
  note         String?
  active       Boolean   @default(true)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([userId, category])
}

// দৈনিক পরিকল্পনা (Daily Planner) — Phase 1 "জ্ঞান ও পরিকল্পনা" feature.
// The morning-planning / evening-review ritual:
//   • MIT = "Most Important Task" (আজকের ৩টি প্রধান কাজ)
//   • todos = smaller personal/work items for the same date
// One row per planned item, dated per Asia/Dhaka day like the rest of the app.
model PlannerTask {
  id        String    @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD (Asia/Dhaka)
  title     String
  isMit     Boolean   @default(false)
  done      Boolean   @default(false)
  doneAt    DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// শেখা মডিউল (Learning) — Phase 1 flagship: subject tracks with lessons +
// SM-2 spaced-repetition flashcards. Links to a daily-practice Habit and a
// progress Goal (soft references — deleting a habit/goal just unlinks).
model LearningTrack {
  id            String   @id @default(cuid())
  userId        String
  title         String
  subject       String   @default("অন্য") // আরবি | ইংরেজি | কোডিং | পড়াশোনা | HSC | অন্য
  icon          String   @default("BookOpen")
  color         String   @default("#0d9488")
  minutesPerDay Int      @default(20)
  habitId       String? // linked daily-practice habit
  goalId        String? // linked progress goal (currentValue = lessons done)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  cards   Flashcard[]

  @@index([userId, archived])
}

model Lesson {
  id        String    @id @default(cuid())
  trackId   String
  userId    String
  title     String
  content   String?
  sortOrder Int       @default(0)
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  track LearningTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId, sortOrder])
}

model Flashcard {
  id             String    @id @default(cuid())
  trackId        String
  userId         String
  front          String
  back           String
  // SM-2 spaced repetition state
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  dueDate        String // YYYY-MM-DD (Asia/Dhaka)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  track LearningTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([trackId])
}

// Web Push subscriptions for sending push notifications to users' devices.
// One user can have multiple subscriptions (multiple devices/browsers).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique // FCM/Apple push endpoint URL
  p256dh    String   // ECDH public key (Base64URL)
  auth      String   // auth secret (Base64URL)
  expirationTime Int? // epoch ms when subscription expires (null = no expiry)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
